{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-club-website",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "agentclub.dev",
      "custom_domain": true,
    },
  ],
}
